{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realizo-auth-sandbox",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "REALIZO_ENV": "sandbox",
    "REALIZO_WALLET_ONLY": "true",
    "REALIZO_AUTH_PROVIDER": "native",
    "REALIZO_AUTH_ORIGIN": "https://realizo-auth-sandbox.abelarriaga0.workers.dev",
    "PAYPAL_MODE": "sandbox",
    "MUAPI_GENERATION_ENABLED": "true",
    "REALIZO_MUAPI_PILOT": "true",
    "REALIZO_MULTI_MODEL_SANDBOX": "true",
    "REALIZO_AI_PREMIUM_ENABLED": "false",
    "OPENAI_PREMIUM_MODEL": "gpt-5.5"
  },
  "d1_databases": [
    {
      "binding": "WALLETS_DB",
      "database_name": "realizo-wallets-sandbox",
      "database_id": "2561f6c8-bfb2-4ea4-8527-7fec29188edf",
      "migrations_dir": "migrations"
    }
  ]
}
