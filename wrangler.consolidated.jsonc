{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realizo-auth-sandbox",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "REALIZO_ENV": "production",
    "REALIZO_WALLET_ONLY": "true",
    "REALIZO_AUTH_PROVIDER": "native",
    "REALIZO_AUTH_ORIGIN": "https://realizo-auth-sandbox.abelarriaga0.workers.dev",
    "PAYPAL_MODE": "live",
    "REALIZO_LIVE_PAYMENTS_ENABLED": "false",
    "MUAPI_GENERATION_ENABLED": "false",
    "REALIZO_MUAPI_PILOT": "false",
    "REALIZO_MULTI_MODEL_SANDBOX": "false",
    "REALIZO_AI_PREMIUM_ENABLED": "false",
    "REALIZO_AI_PREMIUM_PUBLIC_ENABLED": "false",
    "REALIZO_TEMPLATE_EXPLOSION_URL": "https://realizo-auth-sandbox.abelarriaga0.workers.dev/templates/explosion-premium-azul.webp",
    "REALIZO_TEMPLATE_IMAGE_MODEL_ID": "realizo_nano_banana_2_1_edit_4k",
    "REALIZO_TEMPLATE_ANALYZER_MODEL_ID": "realizo_gemini_2_5_flash",
    "REALIZO_TEMPLATE_IMAGES_ENABLED": "false",
    "REALIZO_MEDIA_D1_FALLBACK": "true"
  },
  "d1_databases": [
    {
      "binding": "WALLETS_DB",
      "database_name": "realizo-wallets-sandbox",
      "database_id": "2561f6c8-bfb2-4ea4-8527-7fec29188edf",
      "migrations_dir": "migrations"
    }
  ]
}
